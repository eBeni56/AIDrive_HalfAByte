{
  "$defs": {
    "Calibration": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/CalibrationStatus"
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalibrationPhase"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "progress": {
          "title": "Progress",
          "type": "number"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "required": [
        "status",
        "progress"
      ],
      "title": "Calibration",
      "type": "object"
    },
    "CalibrationPhase": {
      "enum": [
        "OPEN_EYES",
        "CLOSED_EYES"
      ],
      "title": "CalibrationPhase",
      "type": "string"
    },
    "CalibrationStatus": {
      "enum": [
        "CALIBRATING",
        "DONE",
        "DEFAULTS"
      ],
      "title": "CalibrationStatus",
      "type": "string"
    },
    "DetectionOut": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/DetectionType"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "status": {
          "$ref": "#/$defs/DetectionStatus"
        },
        "started_t": {
          "title": "Started T",
          "type": "number"
        },
        "ended_t": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ended T"
        },
        "duration_s": {
          "title": "Duration S",
          "type": "number"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "severity",
        "status",
        "started_t",
        "ended_t",
        "duration_s"
      ],
      "title": "DetectionOut",
      "type": "object"
    },
    "DetectionStatus": {
      "enum": [
        "STARTED",
        "ONGOING",
        "ENDED"
      ],
      "title": "DetectionStatus",
      "type": "string"
    },
    "DetectionType": {
      "enum": [
        "EYES_CLOSED",
        "DISTRACTED",
        "PHONE_USE"
      ],
      "title": "DetectionType",
      "type": "string"
    },
    "EyeSource": {
      "enum": [
        "BOTH",
        "LEFT_ONLY",
        "RIGHT_ONLY"
      ],
      "title": "EyeSource",
      "type": "string"
    },
    "EyeState": {
      "enum": [
        "OPEN",
        "CLOSED",
        "UNKNOWN"
      ],
      "title": "EyeState",
      "type": "string"
    },
    "Eyes": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/EyeState",
          "default": "UNKNOWN"
        },
        "state_for_s": {
          "default": 0.0,
          "title": "State For S",
          "type": "number"
        },
        "openness": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openness"
        },
        "source": {
          "$ref": "#/$defs/EyeSource",
          "default": "BOTH"
        }
      },
      "title": "Eyes",
      "type": "object"
    },
    "Gaze": {
      "additionalProperties": false,
      "properties": {
        "zone": {
          "$ref": "#/$defs/GazeZone",
          "default": "UNKNOWN"
        },
        "zone_for_s": {
          "default": 0.0,
          "title": "Zone For S",
          "type": "number"
        },
        "yaw_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yaw Deg"
        },
        "pitch_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch Deg"
        }
      },
      "title": "Gaze",
      "type": "object"
    },
    "GazeZone": {
      "description": "Where the driver looks (config: gaze_zones + gaze.on_road_*).",
      "enum": [
        "ROAD",
        "REAR_MIRROR",
        "LEFT_MIRROR",
        "RIGHT_MIRROR",
        "LEFT_SIDE",
        "RIGHT_SIDE",
        "UP",
        "DOWN",
        "UNKNOWN"
      ],
      "title": "GazeZone",
      "type": "string"
    },
    "Head": {
      "additionalProperties": false,
      "properties": {
        "yaw_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Yaw Deg"
        },
        "pitch_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch Deg"
        },
        "roll_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roll Deg"
        }
      },
      "title": "Head",
      "type": "object"
    },
    "Quality": {
      "additionalProperties": false,
      "properties": {
        "fps": {
          "title": "Fps",
          "type": "number"
        },
        "camera_fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Fps"
        },
        "latency_ms": {
          "title": "Latency Ms",
          "type": "number"
        },
        "face_detected": {
          "title": "Face Detected",
          "type": "boolean"
        },
        "faces_in_view": {
          "title": "Faces In View",
          "type": "integer"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/QualityIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "fps",
        "latency_ms",
        "face_detected",
        "faces_in_view"
      ],
      "title": "Quality",
      "type": "object"
    },
    "QualityIssue": {
      "enum": [
        "CALIBRATING",
        "HEAD_TURNED_TOO_FAR",
        "FACE_TOO_SMALL",
        "LOW_LIGHT",
        "LOW_FPS",
        "FACE_PARTIALLY_OUT_OF_FRAME"
      ],
      "title": "QualityIssue",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "NONE",
        "WARNING",
        "DANGER"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "highest_severity": {
          "$ref": "#/$defs/Severity",
          "default": "NONE"
        },
        "active": {
          "items": {
            "$ref": "#/$defs/DetectionType"
          },
          "title": "Active",
          "type": "array"
        }
      },
      "title": "Summary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "driver_state",
      "default": "driver_state",
      "title": "Type",
      "type": "string"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "t": {
      "title": "T",
      "type": "number"
    },
    "frame": {
      "title": "Frame",
      "type": "integer"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "quality": {
      "$ref": "#/$defs/Quality"
    },
    "calibration": {
      "$ref": "#/$defs/Calibration"
    },
    "eyes": {
      "$ref": "#/$defs/Eyes"
    },
    "head": {
      "$ref": "#/$defs/Head"
    },
    "gaze": {
      "$ref": "#/$defs/Gaze"
    },
    "detections": {
      "items": {
        "$ref": "#/$defs/DetectionOut"
      },
      "title": "Detections",
      "type": "array"
    }
  },
  "required": [
    "t",
    "frame",
    "summary",
    "quality",
    "calibration",
    "eyes",
    "head",
    "gaze"
  ],
  "title": "DriverState",
  "type": "object"
}
