# Settings for docker compose (read automatically) and for start.bat / start.sh (the two ports they open).
# The values here are the defaults of compose.yml; change them here, not there. No secrets in this file.

# Ports on this PC
SERVER_PORT=8765
SIMULATOR_PORT=8080
DASHBOARD_PORT=8081

# central_point, the server (see central_point/README.md; the warning timings EYES_CLOSED_VOICE_S etc. are listed there)
SERVER_LOG_LEVEL=INFO
GAZE_HZ=10
DASHBOARD_HZ=10
CAMERA_TIMEOUT_S=1.0

# Only for "docker compose --profile replay up": the video in driver_monitor/recordings/ to replay
DM_VIDEO=recording-10.mp4
