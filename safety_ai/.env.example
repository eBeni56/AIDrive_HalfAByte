# safety_ai settings: copy this file to .env (in this folder) and fill in your own values.
# .env is NOT in git (.gitignore ignores every .env except the root one). Never commit or share it.

# The endpoint of your Azure OpenAI / Microsoft Foundry resource. Only the host is used; requests go to
# /openai/v1/responses on it (the project URL Foundry shows refuses the key, the resource-level one works).
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/responses

# The key of that resource (Foundry: the deployment's page, or the resource's "Keys and Endpoint").
AZURE_OPENAI_KEY=<your-key>

# The DEPLOYMENT name you chose when deploying the model (shown in Foundry under "Models + endpoints").
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
